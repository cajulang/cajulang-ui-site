# The site's languages, text and numbers: the dictionary of the current language (data/dict-*.json,
# exported from the original site), the content (data/content.json) and the helpers the pages use.
# The server sets them for each request; the browser from the page's data (main.cajux).
import ui "../caju-ui/ui"
import "std/json"
import "std/strings"

export const LOCALES = "en pt es zh"

export let LANG: str = "en"
export let PATH: str = "/en"              # the path of the page, for the menus
export let D: *json.Value = nil           # the dictionary
export let C: *json.Value = nil           # the content: site, examples, bench, arch, mcp

# the language, page path, dictionary and content of the page being rendered
export fn set(lang: str, path: str, d: *json.Value, c: *json.Value) {
  LANG = lang
  PATH = path
  D = d
  C = c
}

export fn locales() -> []str { return strings.split(LOCALES, " ") }
export fn has_locale(l: str) -> bool { return l == "en" || l == "pt" || l == "es" || l == "zh" }

# <html lang> and Open Graph locale of each language
export fn html_lang(l: str) -> str {
  switch l {
  case "pt": return "pt-BR"
  case "es": return "es"
  case "zh": return "zh-CN"
  }
  return "en"
}
export fn og_locale(l: str) -> str {
  switch l {
  case "pt": return "pt_BR"
  case "es": return "es_ES"
  case "zh": return "zh_CN"
  }
  return "en_US"
}
# each language named in itself
export fn locale_name(l: str) -> str {
  switch l {
  case "pt": return "Português"
  case "es": return "Español"
  case "zh": return "中文"
  }
  return "English"
}

# a path inside the current language: lp("/examples") -> "/pt/examples"; lp("/") -> "/pt"
export fn lp(path: str) -> str {
  if path == "/" { return "/" + LANG }
  return "/" + LANG + path
}

# text of the dictionary at a dotted path
export fn tr(path: str) -> str { return D.get_str(path, "") }
export fn tv(path: str) -> *json.Value { return D.get(path) }
export fn site(key: str) -> str { return C.get_str("site." + key, "") }

# ---------------------------------------------------------------------------------------------
# Numbers, as toLocaleString writes them in each language

fn group_sep() -> str {
  if LANG == "pt" || LANG == "es" { return "." }
  return ","
}
fn dec_sep() -> str {
  if LANG == "pt" || LANG == "es" { return "," }
  return "."
}

# an integer with the thousands separator (es-ES groups only from 10,000)
export fn fmt_int(n: int) -> str {
  neg := n < 0
  if neg { n = -n }
  s := str(n)
  if LANG == "es" && len(s) <= 4 {
    if neg { return "-" + s }
    return s
  }
  b := strings.Builder{}
  for i := 0; i < len(s); i++ {
    if i > 0 && (len(s) - i) % 3 == 0 { b.write(group_sep()) }
    b.write_byte(int(s[i]))
  }
  if neg { return "-" + b.string() }
  return b.string()
}

# a number with at most max_frac decimals and at least min_frac (rounded half away from zero)
export fn fmt_num(x: num, min_frac: int, max_frac: int) -> str {
  neg := x < 0.0
  if neg { x = -x }
  scale := 1
  for i := 0; i < max_frac; i++ { scale = scale * 10 }
  v := int(x * num(scale) + 0.5)
  whole := v / scale
  frac := v % scale
  fs := ""
  if max_frac > 0 {
    fs = str(frac)
    while len(fs) < max_frac { fs = "0" + fs }
    while len(fs) > min_frac && strings.has_suffix(fs, "0") { fs = fs[0:len(fs) - 1] }
  }
  out := fmt_int(whole)
  if fs != "" { out = out + dec_sep() + fs }
  if neg && v != 0 { return "-" + out }
  return out
}

# milliseconds as the benchmark table shows them: "25 ms", "1,21 s"
export fn fmt_ms(ms: int) -> str {
  if ms < 1000 { return str(ms) + " ms" }
  return fmt_num(num(ms) / 1000.0, 2, 2) + " s"
}

# ---------------------------------------------------------------------------------------------
# Rich text: the dictionary's markup, `code`, ``code with a backtick``, **bold** and *em*

# inline code inside prose
export fn code(s: str) -> *ui.Node {
  return ui.h("code", []ui.Attr{ui.a("class", "rounded-md bg-muted px-1.5 py-0.5 font-mono text-[0.9em]")}, []*ui.Node{ui.text(s)})
}

fn at(s: str, i: int) -> int {
  if i < len(s) { return int(s[i]) }
  return 0
}

fn is_space(c: int) -> bool { return c == 32 || c == 9 || c == 10 || c == 13 }

# the end of a markup piece starting at i (exclusive), or -1: the same alternatives, in the same
# order, as the original site's regular expression
fn piece(s: str, i: int) -> (int, str) {
  # ``.+?``
  if at(s, i) == '`' && at(s, i + 1) == '`' && at(s, i + 2) != 10 && i + 2 < len(s) {
    j := i + 3
    while j + 1 < len(s) && at(s, j) != 10 {
      if at(s, j) == '`' && at(s, j + 1) == '`' { return j + 2, "code2" }
      j++
    }
  }
  # `[^`]+`
  if at(s, i) == '`' {
    j := i + 1
    while j < len(s) && at(s, j) != '`' { j++ }
    if j < len(s) && j > i + 1 { return j + 1, "code" }
  }
  # \*\*[^*]+\*\*
  if at(s, i) == '*' && at(s, i + 1) == '*' {
    j := i + 2
    while j < len(s) && at(s, j) != '*' { j++ }
    if j > i + 2 && at(s, j) == '*' && at(s, j + 1) == '*' { return j + 2, "bold" }
  }
  # \*[^*\s][^*]*\*
  if at(s, i) == '*' && i + 1 < len(s) && at(s, i + 1) != '*' && !is_space(at(s, i + 1)) {
    j := i + 2
    while j < len(s) && at(s, j) != '*' { j++ }
    if j < len(s) { return j + 1, "em" }
  }
  return -1, ""
}

export fn rich(s: str) -> []*ui.Node {
  out := []*ui.Node{}
  start := 0
  i := 0
  while i < len(s) {
    end, kind := piece(s, i)
    if end < 0 {
      i++
      continue
    }
    if i > start { out = append(out, ui.text(s[start:i])) }
    p := s[i:end]
    if kind == "code2" {
      out = append(out, code(strings.trim_space(p[2:len(p) - 2])))
    } else if kind == "code" {
      out = append(out, code(p[1:len(p) - 1]))
    } else if kind == "bold" {
      out = append(out, ui.h("strong", nil, []*ui.Node{ui.text(p[2:len(p) - 2])}))
    } else {
      out = append(out, ui.h("em", nil, []*ui.Node{ui.text(p[1:len(p) - 1])}))
    }
    i = end
    start = end
  }
  if start < len(s) { out = append(out, ui.text(s[start:])) }
  return out
}

# rich text at a dotted path of the dictionary
export fn rt(path: str) -> []*ui.Node { return rich(tr(path)) }
