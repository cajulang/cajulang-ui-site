# The brand page: palette, icon variants, signatures, sizes and type.
import ui "../caju-ui/ui"
import "std/strings"
import "./i18n"
import "./core"
import "./icons"

fn b(path: str) -> str { return i18n.tr("brand." + path) }

fn swatch(hex: str, light: bool, tall: bool) -> *ui.Node {
  c := i18n.tv("brand.colors").field(hex)
  cls := "flex flex-col justify-end gap-1 rounded-2xl p-5"
  if tall { cls = cls + " min-h-52" } else { cls = cls + " min-h-36" }
  if hex == "#FFF4E6" || hex == "#F3E6D3" { cls = cls + " shadow-[inset_0_0_0_1px_#E2D6C6]" }
  fg := "#1E1712"
  if light { fg = "#FFF4E6" }
  name_cls := "font-bold text-[17px]"
  if tall { name_cls = "font-bold text-[22px]" }
  return (
    <div class={cls} style={"background:" + hex + ";color:" + fg}>
      <div class={name_cls}>{c.get_str("name", "")}</div>
      <div class="flex items-center gap-1 font-mono text-[13px]">
        {hex}
        <core.CopyButton text={hex} label={i18n.tr("ui.copy") + " " + hex} cls={core.btn("copy-swatch")} />
      </div>
      <div class="text-[13px]">{c.get_str("use", "")}</div>
    </div>
  )
}

fn lockup(dark: bool, layout: str) -> *ui.Node {
  icon := "principal"
  text := "#1E1712"
  accent := "#C8232F"
  if dark {
    icon = "invertido"
    text = "#FFF4E6"
    accent = "#F0603A"
  }
  # ("leading-none" is in the original source, but tailwind-merge drops it before the text-[size])
  word := fn(size: str) -> *ui.Node {
    return <div class={"font-bold tracking-[-0.035em] " + size} style={"color:" + text}>caju<span style={"color:" + accent}>lang</span></div>
  }
  if layout == "horizontal" {
    return <div class="flex items-center gap-4 sm:gap-[22px]">{core.caju_icon(icon, 88, "sm:size-[110px]", "")}{word("text-[56px] sm:text-[92px]")}</div>
  }
  if layout == "vertical" {
    return <div class="flex flex-col items-center gap-5">{core.caju_icon(icon, 120, "", "")}{word("text-[52px] sm:text-[64px]")}</div>
  }
  return <div class="flex items-center gap-[9px]">{core.caju_icon(icon, 44, "", "")}{word("text-[37px]")}</div>
}

fn st(id: str, text: str) -> *ui.Node { return <span id={id}>{text}</span> }

export fn Brand() -> *ui.Node {
  main := []*ui.Node{}
  for _, hl := range [][]str{[]str{"#FFF4E6", ""}, []str{"#1E1712", "l"}, []str{"#C8232F", "l"}, []str{"#8A6B4E", "l"}} {
    main = append(main, swatch(hl[0], hl[1] == "l", true))
  }
  support := []*ui.Node{}
  for _, hl := range [][]str{[]str{"#14100D", "l"}, []str{"#F3E6D3", ""}, []str{"#6B5B4E", "l"}, []str{"#F0603A", "l"}, []str{"#9E1424", "l"}, []str{"#B8A99A", ""}} {
    support = append(support, swatch(hl[0], hl[1] == "l", false))
  }
  variants := []*ui.Node{}
  for _, v := range strings.split(core.VARIANTS, " ") {
    info := i18n.tv("brand.variants").field(v)
    bg := "#F3E6D3"
    if v == "invertido" || v == "mono-escuro" { bg = "#14100D" }
    fg := "#1E1712"
    if bg == "#14100D" { fg = "#FFF4E6" }
    label := info.get_str("label", "")
    variants = append(variants, (
      <figure class="flex flex-col items-center gap-4 rounded-[20px] px-4 pt-8 pb-4 text-center" style={"background:" + bg + ";color:" + fg}>
        {core.caju_icon(v, 120, "", strings.replace_all(b("variantAlt"), "{label}", label))}
        <figcaption class="flex flex-col gap-0.5">
          <span class="text-[15px] font-bold">{label}</span>
          <span class="text-[13px] opacity-80">{info.get_str("use", "")}</span>
        </figcaption>
        <a href={"/brand/caju-icon-" + v + ".svg"} download="" data-slot="button" data-variant="ghost" data-size="sm" class={core.btn("download")}>{icons.icon("download", "")} SVG</a>
      </figure>
    ))
  }
  lockups := []*ui.Node{}
  for _, dark := range []bool{false, true} {
    bg := "#FFF4E6"
    fg := "#6B5B4E"
    if dark {
      bg = "#14100D"
      fg = "#B8A99A"
    }
    rows := []*ui.Node{}
    for _, l := range []str{"horizontal", "vertical", "compact"} {
      rows = append(rows, (
        <div class="flex flex-col gap-4">
          <div class="text-sm font-medium">{b("layouts." + l)}</div>
          {lockup(dark, l)}
        </div>
      ))
    }
    lockups = append(lockups, <div class="flex min-w-0 flex-col gap-6 overflow-x-auto p-8 sm:p-14" style={"background:" + bg + ";color:" + fg}>{rows}</div>)
  }
  sizes := []*ui.Node{}
  for _, v := range []str{"principal", "invertido"} {
    bg := "#FFF4E6"
    fg := "#6B5B4E"
    if v == "invertido" {
      bg = "#14100D"
      fg = "#B8A99A"
    }
    icons_row := []*ui.Node{}
    for _, s := range []int{128, 64, 48, 32, 24, 16} {
      icons_row = append(icons_row, (
        <div class="flex flex-col items-center gap-2">
          {core.caju_icon(v, s, "", "")}
          <div class="font-mono text-xs">{s}px</div>
        </div>
      ))
    }
    sizes = append(sizes, <div class="flex flex-wrap items-end gap-6 rounded-[20px] p-8" style={"background:" + bg + ";color:" + fg}>{icons_row}</div>)
  }
  return (
    <>
      <core.PageHero crumb={i18n.tr("nav.brand")} title={b("title")} lead={ui.text(b("lead"))} />

      <section aria-labelledby="palette">
        <core.Container cls="flex flex-col gap-8 py-16 sm:py-20">
          <core.SectionTitle title={st("palette", b("paletteTitle"))} lead={ui.text(b("paletteLead"))} />
          <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">{main}</div>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">{support}</div>
        </core.Container>
      </section>

      <section aria-labelledby="variants" class="bg-surface">
        <core.Container cls="flex flex-col gap-8 py-16 sm:py-20">
          <core.SectionTitle title={st("variants", b("variantsTitle"))} lead={ui.text(b("variantsLead"))} />
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">{variants}</div>
        </core.Container>
      </section>

      <section aria-labelledby="lockups">
        <core.Container cls="flex flex-col gap-8 py-16 sm:py-20">
          <core.SectionTitle title={st("lockups", b("signaturesTitle"))} lead={ui.text(b("signaturesLead"))} />
          <div class="grid grid-cols-1 overflow-hidden rounded-[20px] lg:grid-cols-2">{lockups}</div>
        </core.Container>
      </section>

      <section aria-labelledby="sizes" class="bg-surface">
        <core.Container cls="flex flex-col gap-8 py-16 sm:py-20">
          <core.SectionTitle title={st("sizes", b("sizesTitle"))} lead={ui.text(b("sizesLead"))} />
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">{sizes}</div>
        </core.Container>
      </section>

      <section aria-labelledby="type">
        <core.Container cls="flex flex-col gap-8 py-16 sm:py-20">
          <core.SectionTitle title={st("type", b("typeTitle"))} lead={nil} />
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col gap-3 rounded-[20px] bg-card p-8 shadow-[inset_0_0_0_1px_var(--color-border)]">
              <div class="text-sm text-muted-foreground">{b("typeSans")}</div>
              <div class="text-5xl font-bold tracking-[-0.04em]">{b("typeSansSample")}</div>
              <p class="text-lg leading-relaxed text-muted-foreground">{b("typeSansBody")}</p>
            </div>
            <div class="flex flex-col gap-3 rounded-[20px] bg-code p-8 text-code-text">
              <div class="text-sm text-code-dim">{b("typeMono")}</div>
              <div class="font-mono text-2xl"><span class="text-tok-kw">fn</span> <span class="text-tok-fn">main</span>()</div>
              <div class="font-mono text-sm text-code-dim">$ caju build -o app main.caju</div>
            </div>
          </div>
        </core.Container>
      </section>
    </>
  )
}
