let bench_card = style.def("mcp-bench-card", "@card rounded-[20px] p-2")
let bench_scroll = style.def("mcp-bench-scroll", "relative w-full overflow-x-auto")
let bench_tbl = style.def("mcp-bench-table", "w-full min-w-[640px] caption-bottom text-sm")
let bench_head_row = style.def("mcp-bench-head-row", "border-b transition-colors")
let bench_body = style.def("mcp-bench-body", "[&_tr:last-child]:border-0")
let mode_total = style.def("mode-total", "flex items-baseline gap-2 rounded-2xl bg-card px-5 py-3 shadow-[inset_0_0_0_1px_var(--color-border)]")
let mode_total_mcp = style.def("mode-total-mcp", "flex items-baseline gap-2 rounded-2xl bg-primary px-5 py-3 text-primary-foreground")
let mode_name = style.def("mode-name", "font-mono text-sm font-bold uppercase")
let mode_score = style.def("mode-score", "text-3xl font-bold")
let mode_unit = style.def("mode-unit", "text-sm opacity-80")
