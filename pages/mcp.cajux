let finding_grid = style.def("finding-grid", "grid grid-cols-1 gap-3 md:grid-cols-2")
let note = style.def("mcp-note", "text-[13px] leading-relaxed text-muted-foreground")
let note_link = style.def("mcp-note-link", "underline underline-offset-2 hover:text-foreground")
let setup_grid = style.def("setup-grid", "@page-width grid grid-cols-1 gap-8 py-16 sm:py-20 lg:grid-cols-2")
let setup_column = style.def("setup-column", "flex flex-col gap-5")
let setup_item = style.def("setup-item", "flex flex-col gap-2")
let setup_label = style.def("setup-label", "text-sm font-bold")
let setup_note = style.def("setup-note", "text-sm leading-relaxed text-muted-foreground")
let why = style.def("why", "flex flex-col justify-center gap-3 rounded-[20px] bg-inverse p-8 text-inverse-foreground")
let why_title = style.def("why-title", "text-[26px] font-bold tracking-[-0.02em]")
let why_text = style.def("why-text", "leading-[1.75] text-inverse-muted")

fn fnum(v: num) -> str { return i18n.fmt_num(v, 0, 1) }
fn money(v: num) -> str { return i18n.fmt_num(v, 3, 3) }

fn fmt(metric: str, v: num) -> str {
  if metric == "cost" { return money(v) }
  return fnum(v)
}

# CLI and MCP side by side for one metric (lower is better), the bars scaled to the larger one
fn compare(label: str, metric: str) -> *ui.Node {
  all := i18n.C.get("mcp.benchAll")
  cli := all.get_float("cli." + metric, 0.0)
  mcp := all.get_float("mcp." + metric, 0.0)
  top := cli
  if mcp > top { top = mcp }
  let ratio = 0.0
  if mcp > 0.0 { ratio = cli / mcp }
  rows := []*ui.Node{}
  for _, mode := range []str{"cli", "mcp"} {
    v := all.get_float(mode + "." + metric, 0.0)
    w := 100.0 * v / top
    if w < 3.0 { w = 3.0 }
    fill := style.pick(mode == "mcp", metric_fill_mcp, metric_fill)
    rows = append(rows, (
      <div class={metric_bar_row}>
        <span class={metric_mode}>{mode}</span>
        <div class={metric_track} aria-hidden="true"><div class={fill} style={"width:" + str(w) + "%"}></div></div>
        <span class={metric_value}>{fmt(metric, v)}</span>
      </div>
    ))
  }
  return (
    <div class={panel}>
      <div class={metric_head}>
        <span class={metric_name}>{label}</span>
        <span class={metric_ratio}>{fnum(ratio)}×</span>
      </div>
      {rows}
    </div>
  )
}

fn role_icon(role: str) -> *ui.Node {
  cls := role_icon_style
  if role == "tool" { return icons.icon("wrench", role_icon_tool) }
  if role == "assistant" { return icons.icon("bot", cls) }
  return icons.icon("user", cls)
}

# a real session, step by step: what the assistant sent to a tool and what came back
fn AiDemo() -> *ui.Node {
  i := ui.use_int(0)
  steps := i18n.C.get_array("mcp.demo")
  bars := []*ui.Node{}
  for k := 0; k < len(steps); k++ {
    kk := k
    bars = append(bars, (
      <li class={demo_step}>
        <button tabindex="-1" onClick={fn() { i.set(kk) }} class={style.pick(k <= i.v, demo_bar_done, demo_bar)}></button>
      </li>
    ))
  }
  shown := []*ui.Node{}
  for k := 0; k <= i.v && k < len(steps); k++ {
    s := steps[k]
    role := s.get_str("role", "")
    title := s.get_str("title", "")
    lang := s.get_str("lang", "")
    body := s.get_str("body", "")
    tool := role == "tool"
    cls := message_assistant
    if tool { cls = message_tool }
    if role == "user" { cls = message_user }
    let past: any = nil
    if k < i.v { past = "" }
    head_cls := style.pick(tool, message_head_tool, message_head)
    title_cls := style.pick(tool, message_title_tool, message_title)
    pre_cls := style.pick(tool, message_code, message_code_boxed)
    content := ui.either(lang != "" && lang != "text", <pre class={pre_cls}>{body}</pre>, <p class={message_text}>{body}</p>)
    shown = append(shown, (
      <div class={cls} data-past={past}>
        {role_icon(role)}
        <div class={message_main}>
          <div class={head_cls}>
            {i18n.tr("ai.demoRoles." + role)}
            {ui.when(title != "", <span class={title_cls}>{title}</span>)}
          </div>
          {content}
        </div>
      </div>
    ))
  }
  step := strings.replace_all(strings.replace_all(i18n.tr("ai.demoStep"), "{n}", str(i.v + 1)), "{total}", str(len(steps)))
  return (
    <div class={demo}>
      <ol class={demo_steps} aria-hidden="true">{bars}</ol>
      <div class={demo_messages} aria-live="polite">{shown}</div>
      <div class={demo_controls}>
        <button data-slot="button" data-variant="outline" data-size="default" class={core.btn("outline-10")} disabled={i.v == 0} onClick={fn() { if i.v > 0 { i.set(i.v - 1) } }}>
          {icons.icon("chevron-left", "")} {i18n.tr("ai.demoPrev")}
        </button>
        <button data-slot="button" data-variant="default" data-size="default" class={core.btn("primary-10")} disabled={i.v == len(steps) - 1} onClick={fn() { if i.v < len(steps) - 1 { i.set(i.v + 1) } }}>
          {i18n.tr("ai.demoNext")} {icons.icon("chevron-right", "")}
        </button>
        <span class={demo_counter}>{step}</span>
      </div>
    </div>
  )
}

fn ToolExplorer() -> *ui.Node {
  tools := i18n.tv("ai.tools").items
  sel := ui.use_str(tools[0].get_str("name", ""))
  desc := ""
  tabs := []*ui.Node{}
  for _, x := range tools {
    name := x.get_str("name", "")
    on := name == sel.v
    if on { desc = x.get_str("desc", "") }
    cls := style.pick(on, tool_tab_on, tool_tab)
    name_cls := style.pick(on, tool_name_on, tool_name)
    tabs = append(tabs, (
      <button role="tab" aria-selected={core.bs(on)} onClick={fn() { sel.set(name) }} class={cls}>
        <span class={name_cls}>{name}</span>
      </button>
    ))
  }
  ex := i18n.C.get("mcp.toolExamples").field(sel.v)
  panes := []*ui.Node{}
  for _, kind := range []str{"request", "response"} {
    label := i18n.tr("ai." + kind)
    panes = append(panes, (
      <div class={json_pane}>
        <div class={json_bar}>{label} · {sel.v}</div>
        <pre class={json_body}>{ex.get_str(kind, "")}</pre>
      </div>
    ))
  }
  return (
    <div class={explorer}>
      <div role="tablist" aria-orientation="vertical" class={tool_list}>{tabs}</div>
      <div class={tool_detail}>
        <p class={tool_desc}>{i18n.rich(desc)}</p>
        {panes}
      </div>
    </div>
  )
}

fn span_id(id: str, text: str) -> *ui.Node { return <span id={id}>{text}</span> }

fn bench_table() -> *ui.Node {
  runs := i18n.C.get_int("mcp.benchRuns", 0)
  rows := []*ui.Node{}
  for _, b := range i18n.C.get_array("mcp.bench") {
    id := b.get_str("id", "")
    let task: *json.Value = nil
    for _, t := range i18n.tv("ai.benchTasks").items {
      if t.get_str("id", "") == id { task = t }
    }
    for k, mode := range []str{"cli", "mcp"} {
      m := b.field(mode)
      vals := []str{str(m.get_int("ok", 0)) + "/" + str(runs), fnum(m.get_float("turns", 0.0)), fnum(m.get_float("compiler", 0.0)), fnum(m.get_float("seconds", 0.0))}
      cells := []*ui.Node{}
      for vi, v := range vals {
        cls := style.pick(mode == "mcp", bench_value_mcp, bench_value)
        cells = append(cells, (
          <td data-slot="table-cell" class={cls}>
            {ui.when(vi == 0, <span class={bench_mode}>{mode}</span>)}
            {v}
          </td>
        ))
      }
      first := ui.when(k == 0, (
        <div class={bench_task}>
          <span class={bench_task_title}>{task.get_str("title", "")}</span>
          <span class={bench_task_desc}>{task.get_str("desc", "")}</span>
        </div>
      ))
      row_cls := style.pick(k == 0, bench_row_first, bench_row)
      rows = append(rows, (
        <tr data-slot="table-row" class={row_cls}>
          <td data-slot="table-cell" class={bench_task_cell}>{first}</td>
          {cells}
        </tr>
      ))
    }
  }
  return (
    <div data-slot="card" data-size="default" class={bench_card}>
      <div data-slot="table-container" class={bench_scroll}>
        <table data-slot="table" class={bench_tbl}>
          <thead data-slot="table-header">
            <tr data-slot="table-row" class={bench_head_row}>
              <th data-slot="table-head" class={bench_head}>{i18n.tr("ai.benchCols.task")}</th>
              <th data-slot="table-head" class={bench_head_number}>{i18n.tr("ai.metrics.ok")}</th>
              <th data-slot="table-head" class={bench_head_number}>{i18n.tr("ai.metrics.turns")}</th>
              <th data-slot="table-head" class={bench_head_number}>{i18n.tr("ai.metrics.compiler")}</th>
              <th data-slot="table-head" class={bench_head_number}>{i18n.tr("ai.metrics.seconds")}</th>
            </tr>
          </thead>
          <tbody data-slot="table-body" class={bench_body}>{rows}</tbody>
        </table>
      </div>
    </div>
  )
}

export fn Mcp() -> *ui.Node {
  setup := i18n.C.get_str("mcp.setupClaude", "")
  setup_json := i18n.C.get_str("mcp.setupJson", "")
  runs := i18n.C.get_int("mcp.benchRuns", 0)
  total := len(i18n.C.get_array("mcp.bench")) * runs
  modes := []*ui.Node{}
  for _, mode := range []str{"cli", "mcp"} {
    cls := style.pick(mode == "mcp", mode_total_mcp, mode_total)
    modes = append(modes, (
      <div class={cls}>
        <span class={mode_name}>{mode}</span>
        <span class={mode_score}>{i18n.C.get_int("mcp.benchAll." + mode + ".ok", 0)}/{total}</span>
        <span class={mode_unit}>{i18n.tr("ai.metrics.ok")}</span>
      </div>
    ))
  }
  metrics := []*ui.Node{}
  for _, m := range []str{"turns", "compiler", "tokens", "seconds", "cost"} {
    metrics = append(metrics, compare(i18n.tr("ai.metrics." + m), m))
  }
  findings := []*ui.Node{}
  for _, f := range i18n.tv("ai.findings").items {
    findings = append(findings, (
      <div class={panel}>
        <h3 class={finding_title}>{f.get_str("title", "")}</h3>
        <p class={finding_text}>{i18n.rich(f.get_str("desc", ""))}</p>
      </div>
    ))
  }
  return (
    <>
      <core.PageHero crumb={i18n.tr("nav.ai")} title={i18n.tr("ai.title")} lead={ui.text(i18n.tr("ai.lead"))}>
        <div class={hero_command}>
          <code class={command_text}><span class={highlight.token_class("kw")}>$ </span>{setup}</code>
          <core.CopyButton text={setup} label={i18n.tr("ui.copy")} cls={core.btn("copy-code")} />
        </div>
      </core.PageHero>

      <section aria-labelledby="bench-h" class={band_alt}>
        <core.Container cls={core.SECTION}>
          <core.SectionTitle title={span_id("bench-h", i18n.tr("ai.benchTitle"))} lead={ui.frag(i18n.rt("ai.benchLead"))} />
          <div class={mode_totals}>{modes}</div>
          <div class={metric_grid}>{metrics}</div>
          {bench_table()}
          <div class={finding_grid}>{findings}</div>
          <p class={note}>
            {i18n.rt("ai.benchNote")}{" "}<a href={i18n.C.get_str("mcp.benchUrl", "")} class={note_link}>bench/mcp/RESULTS.md</a>
          </p>
        </core.Container>
      </section>

      <section aria-labelledby="demo-h">
        <core.Container cls={core.SECTION}>
          <core.SectionTitle title={span_id("demo-h", i18n.tr("ai.demoTitle"))} lead={ui.text(i18n.tr("ai.demoLead"))} />
          <AiDemo />
        </core.Container>
      </section>

      <section aria-labelledby="tools-h" class={band_alt}>
        <core.Container cls={core.SECTION}>
          <core.SectionTitle title={span_id("tools-h", i18n.tr("ai.toolsTitle"))} lead={ui.text(i18n.tr("ai.toolsLead"))} />
          <ToolExplorer />
        </core.Container>
      </section>

      <section aria-labelledby="setup-h">
        <core.Container cls={setup_grid}>
          <div class={setup_column}>
            <core.SectionTitle title={span_id("setup-h", i18n.tr("ai.setupTitle"))} lead={ui.text(i18n.tr("ai.setupLead"))} />
            <div class={setup_item}>
              <span class={setup_label}>{i18n.tr("ai.claudeCode")}</span>
              <div class={command_box}>
                <code class={command_text}>{setup}</code>
                <core.CopyButton text={setup} label={i18n.tr("ui.copy")} cls={core.btn("copy-code")} />
              </div>
            </div>
            <div class={setup_item}>
              <span class={setup_label}>{i18n.tr("ai.otherClients")}</span>
              <div class={command_box}>
                <pre class={command_json}>{setup_json}</pre>
                <core.CopyButton text={setup_json} label={i18n.tr("ui.copy")} cls={core.btn("copy-code")} />
              </div>
            </div>
            <p class={setup_note}>{i18n.rt("ai.setupNote")}</p>
          </div>
          <div class={why}>
            <h2 class={why_title}>{i18n.tr("ai.whyTitle")}</h2>
            <p class={why_text}>{i18n.rt("ai.why")}</p>
          </div>
        </core.Container>
      </section>
    </>
  )
}
