# the example with this file name, in the content
export fn example(file: str) -> *json.Value {
  for _, g := range i18n.C.get_array("examples.exampleGroups") {
    for _, e := range g.get_array("examples") {
      if e.get_str("file", "") == file { return e }
    }
  }
  return nil
}

export fn strs(v: *json.Value) -> []str {
  out := []str{}
  if v == nil { return out }
  for _, x := range v.items { out = append(out, x.s) }
  return out
}

fn Hero() -> *ui.Node {
  install := i18n.site("install")
  stats := []*ui.Node{}
  for _, s := range i18n.tv("home.stats").items {
    stats = append(stats, (
      <div class={stat}>
        <div class={stat_value}>{s.get_str("value", "")}</div>
        <div class={stat_label}>{s.get_str("label", "")}</div>
      </div>
    ))
  }
  return (
    <section class={hero}>
      <div aria-hidden="true" class={hero_pattern}>
        {core.cashew_pattern("hero-pattern", "", "")}
      </div>
      <core.Container cls={hero_grid}>
        <div class={hero_text}>
          <span data-slot="badge" data-variant="default" class={badge}>v{i18n.site("version")} · {i18n.tr("home.badgeSuffix")}</span>
          <h1 class={hero_title}>{i18n.tr("home.title.0")}<br />{i18n.tr("home.title.1")}</h1>
          <p class={hero_lead}>{i18n.tr("home.lead")}</p>
          <div class={actions}>
            <a class={core.BIG_PRIMARY} href="#install">{i18n.tr("home.install")}</a>
            <a class={core.BIG_OUTLINE} href={i18n.lp("/examples")}>{i18n.tr("home.seeExamples")}</a>
          </div>
          <div class={install_line}>
            <code class={install_command}>{install}</code>
            <core.CopyButton text={install} label={i18n.tr("ui.copyInstall")} cls={core.btn("copy-page")} />
          </div>
        </div>
        <core.CodeWindow file="hello.caju" code={HELLO} output={[]str{"$ caju run hello.caju", "Hello, world!"}} flat={false} />
      </core.Container>
      <core.Container cls={hero_stats}>{stats}</core.Container>
    </section>
  )
}

fn Features() -> *ui.Node {
  cards := []*ui.Node{}
  for _, f := range i18n.tv("home.features").items {
    cards = append(cards, (
      <div data-slot="card" data-size="default" class={feature}>
        <div aria-hidden="true" class={dot}></div>
        <div data-slot="card-title" class={card_title}><h3>{f.get_str("title", "")}</h3></div>
        <p class={body_text}>{i18n.rich(f.get_str("body", ""))}</p>
      </div>
    ))
  }
  return (
    <section id="features" class={features_band}>
      <div aria-hidden="true" class={features_dots}></div>
      <core.Container cls={core.SECTION_WIDE}>
        <core.SectionTitle title={ui.text(i18n.tr("home.featuresTitle"))} lead={ui.text(i18n.tr("home.featuresLead"))} />
        <div class={features_grid}>{cards}</div>
      </core.Container>
    </section>
  )
}

fn Code() -> *ui.Node {
  items := []*ui.Node{}
  for _, file := range []str{"divide.caju", "shapes.caju"} {
    e := example(file)
    info := i18n.tv("examples.items").field(file)
    items = append(items, (
      <div class={code_sample}>
        <div class={code_sample_head}>
          <h3 class={code_sample_title}>{info.get_str("title", "")}</h3>
          <p class={body_text}>{info.get_str("description", "")}</p>
        </div>
        <core.CodeWindow file={file} code={e.get_str("code", "")} output={strs(e.get("output"))} flat={true} />
      </div>
    ))
  }
  return (
    <section id="code">
      <core.Container cls={code_section}>
        <core.SectionTitle title={ui.text(i18n.tr("home.codeTitle"))} lead={ui.text(i18n.tr("home.codeLead"))} />
        <div class={code_grid}>{items}</div>
        <div><a class={core.BIG_OUTLINE} href={i18n.lp("/examples")}>{i18n.tr("home.allExamples")}</a></div>
      </core.Container>
    </section>
  )
}

fn pct(v: num) -> str {
  if v < 2.0 { v = 2.0 }
  return "width:" + str(v) + "%"
}

fn HttpBench() -> *ui.Node {
  cards := []*ui.Node{}
  for _, sc := range i18n.C.get_array("bench.httpBench") {
    routes := sc.get_array("routes")
    top := 0
    for _, r := range routes {
      if r.get_int("caju", 0) > top { top = r.get_int("caju", 0) }
    }
    rows := []*ui.Node{}
    for _, r := range routes {
      caju := r.get_int("caju", 0)
      other := r.get_int("gin", 0)
      if r.get_int("nethttp", 0) > other { other = r.get_int("nethttp", 0) }
      bars := []*ui.Node{}
      for _, srv := range []str{"caju", "gin", "nethttp"} {
        label := map[str]str{"caju": "Caju + web", "gin": "Gin", "nethttp": "Go net/http"}[srv]
        v := r.get_int(srv, 0)
        is := srv == "caju"
        bars = append(bars, (
          <div class={bar_row}>
            <span class={style.pick(is, bar_label_caju, bar_label)}>{label}</span>
            <div class={bar_track} aria-hidden="true">
              <div class={style.pick(is, bar_fill_caju, bar_fill)} style={pct(100.0 * num(v) / num(top))}></div>
            </div>
            <span class={style.pick(is, bar_value_caju, bar_value)}>{i18n.fmt_int(v)}</span>
          </div>
        ))
      }
      rows = append(rows, (
        <div class={route}>
          <div class={route_head}>
            <span class={route_name}>{r.get_str("route", "")}</span>
            <span class={route_ratio}>{i18n.fmt_num(num(caju) / num(other), 0, 1)}×</span>
          </div>
          {bars}
        </div>
      ))
    }
    cards = append(cards, (
      <div data-slot="card" data-size="default" class={http_card}>
        <div class={http_card_head}>
          <h4 class={http_card_title}>{i18n.tr("home.httpScenarios." + sc.get_str("scenario", ""))}</h4>
          <span class={http_unit}>{i18n.tr("home.httpUnit")}</span>
        </div>
        {rows}
      </div>
    ))
  }
  return (
    <div class={http}>
      <div class={http_intro}>
        <h3 class={http_title}>{i18n.tr("home.httpTitle")}</h3>
        <p class={http_lead}>{i18n.rt("home.httpLead")}</p>
      </div>
      <div class={http_grid}>{cards}</div>
      <p class={small_print}>
        {i18n.rt("home.httpNote")}{" "}<a href={i18n.site("web")} class={small_print_link_strong}>{i18n.tr("home.httpRepo")}</a>{" · "}<a href={i18n.C.get_str("bench.httpResults", "")} class={small_print_link}>{i18n.tr("home.httpResults")}</a>
      </p>
    </div>
  )
}

fn Performance() -> *ui.Node {
  rows := []*ui.Node{}
  for _, b := range i18n.C.get_array("bench.benchmarks") {
    rows = append(rows, (
      <tr data-slot="table-row" class={bench_row}>
        <th data-slot="table-head" class={bench_name} scope="row">{b.get_str("name", "")} <span class={bench_n}>n={b.get_str("n", "")}</span></th>
        <td data-slot="table-cell" class={bench_cell_caju}>{i18n.fmt_ms(b.get_int("caju", 0))}</td>
        <td data-slot="table-cell" class={bench_cell}>{i18n.fmt_ms(b.get_int("go", 0))}</td>
        <td data-slot="table-cell" class={bench_cell}>{i18n.fmt_ms(b.get_int("rust", 0))}</td>
        <td data-slot="table-cell" class={bench_cell}>{i18n.fmt_ms(b.get_int("python", 0))}</td>
      </tr>
    ))
  }
  heads := []*ui.Node{}
  for _, l := range []str{"Caju", "Go", "Rust", "Python"} {
    heads = append(heads, <th data-slot="table-head" class={bench_head_number}>{l}</th>)
  }
  top := 0
  for _, s := range i18n.C.get_array("bench.binarySizes") {
    if s.get_int("kb", 0) > top { top = s.get_int("kb", 0) }
  }
  sizes := []*ui.Node{}
  for _, s := range i18n.C.get_array("bench.binarySizes") {
    lang := s.get_str("lang", "")
    kb := s.get_int("kb", 0)
    fill := style.pick(lang == "Caju", size_fill_caju, size_fill)
    sizes = append(sizes, (
      <div class={size_row}>
        <div class={size_head}>
          <span class={size_lang}>{lang}</span>
          <span class={size_kb}>{i18n.fmt_int(kb)} KB</span>
        </div>
        <div class={size_track} aria-hidden="true"><div class={fill} style={pct(100.0 * num(kb) / num(top))}></div></div>
      </div>
    ))
  }
  return (
    <section id="performance" class={performance}>
      <core.Container cls={performance_body}>
        <core.SectionTitle title={ui.text(i18n.tr("home.perfTitle"))} lead={ui.text(i18n.tr("home.perfLead"))} />
        <div class={performance_cards}>
          <div data-slot="card" data-size="default" class={bench_card}>
            <div data-slot="table-container" class={bench_scroll}>
              <table data-slot="table" class={bench_table}>
                <caption data-slot="table-caption" class={bench_caption}>{i18n.tr("home.perfCaption")}</caption>
                <thead data-slot="table-header">
                  <tr data-slot="table-row" class={bench_head_row}>
                    <th data-slot="table-head" class={bench_head}>{i18n.tr("home.perfChallenge")}</th>
                    {heads}
                  </tr>
                </thead>
                <tbody data-slot="table-body" class={bench_body}>{rows}</tbody>
              </table>
            </div>
          </div>
          <div data-slot="card" data-size="default" class={size_card}>
            <div data-slot="card-header" class={size_card_head}>
              <div data-slot="card-title" class={card_title}><h3>{i18n.tr("home.sizeTitle")}</h3></div>
              <div data-slot="card-description" class={size_card_lead}>{i18n.tr("home.sizeLead")}</div>
            </div>
            <div data-slot="card-content" class={size_list}>{sizes}</div>
          </div>
        </div>
        <p class={small_print}>
          {i18n.tr("home.perfNote")}{" "}<a href={i18n.site("benchmarks")} class={small_print_link}>{i18n.tr("home.perfLink")}</a>.
        </p>
        <HttpBench />
      </core.Container>
    </section>
  )
}

fn Packages() -> *ui.Node {
  steps := []*ui.Node{}
  for i, s := range i18n.tv("home.pkgSteps").items {
    steps = append(steps, (
      <li class={pkg_step}>
        {core.step_number(i + 1, false)}
        <div class={step_text}>
          <div class={step_title}>{s.get_str("title", "")}</div>
          <div class={body_text}>{i18n.rich(s.get_str("body", ""))}</div>
        </div>
      </li>
    ))
  }
  return (
    <section id="packages">
      <core.Container cls={packages_grid}>
        <div class={packages_text}>
          <core.SectionTitle title={ui.text(i18n.tr("home.pkgTitle"))} lead={ui.text(i18n.tr("home.pkgLead"))} />
          <ol class={pkg_steps}>{steps}</ol>
        </div>
        {core.terminal([]str{
          "$ caju pkg init github.com/acme/app",
          "created caju.toml for github.com/acme/app",
          "$ caju pkg add github.com/acme/strutil",
          "downloading github.com/acme/strutil@1.1.0",
          "added github.com/acme/strutil@1.1.0; 1 packages ok",
          "$ caju run app.caju",
          "CAJU!",
          "$ caju pkg tree",
          "github.com/acme/app@0.1.0",
          "└── github.com/acme/strutil@1.1.0",
        }, "")}
      </core.Container>
    </section>
  )
}

fn Install() -> *ui.Node {
  cmds := []str{i18n.site("install"), "caju run hello.caju", "caju build -o hello hello.caju\ncaju build --target windows hello.caju"}
  steps := []*ui.Node{}
  for i, s := range i18n.tv("home.installSteps").items {
    title := s.get_str("title", "")
    steps = append(steps, (
      <li class={install_step}>
        <div class={install_step_head}>
          {core.step_number(i + 1, true)}
          <div class={step_title}>{title}</div>
        </div>
        <div class={install_box}>
          <code class={install_box_command}>{cmds[i]}</code>
          <core.CopyButton text={cmds[i]} label={i18n.tr("ui.copy") + ": " + title} cls={core.btn("copy-inverse")} />
        </div>
        <div class={install_note}>{s.get_str("note", "")}</div>
      </li>
    ))
  }
  return (
    <section id="install" class={install_band}>
      <div aria-hidden="true" class={install_pattern}>
        {core.cashew_pattern("install-pattern", "", "")}
      </div>
      <core.Container cls={core.SECTION_WIDE}>
        <div class={install_head}>
          {core.caju_icon("invertido", 64, core.ICON_LIGHT, "")}
          {core.caju_icon("principal", 64, core.ICON_DARK, "")}
          <h2 class={install_title}>{i18n.tr("home.installTitle")}</h2>
        </div>
        <ol class={install_steps}>{steps}</ol>
      </core.Container>
    </section>
  )
}

fn Cta() -> *ui.Node {
  return (
    <section class={cta}>
      <div aria-hidden="true" class={cta_pattern}>
        {core.cashew_pattern("cta-pattern", "", "")}
      </div>
      <core.Container cls={cta_body}>
        {core.themed_icon(96, "")}
        <h2 class={cta_title}>{i18n.tr("home.ctaTitle")}</h2>
        <p class={cta_lead}>{i18n.tr("home.ctaLead")}</p>
        <div class={cta_actions}>
          <a class={core.BIG_PRIMARY} href="#install">{i18n.tr("home.install")}</a>
          <a href={i18n.site("repo")} class={core.BIG_OUTLINE}>{i18n.tr("home.ctaSource")}</a>
        </div>
      </core.Container>
    </section>
  )
}

export fn Home() -> *ui.Node {
  return (
    <>
      <Hero />
      <Features />
      <Code />
      <Performance />
      <Packages />
      <Install />
      <Cta />
    </>
  )
}
