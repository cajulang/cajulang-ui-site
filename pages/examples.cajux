# The examples page.
import ui "../caju-ui/ui"
import "./i18n"
import "./core"
import "./pages/home"

export fn Examples() -> *ui.Node {
  groups := i18n.C.get_array("examples.exampleGroups")
  chips := []*ui.Node{}
  sections := []*ui.Node{}
  for gi, g := range groups {
    id := g.get_str("id", "")
    list := g.get_array("examples")
    name := i18n.tr("examples.groups." + id)
    chips = append(chips, (
      <a href={"#" + id} class="inline-flex h-11 items-center gap-2 rounded-full bg-card px-4 text-[15px] font-medium shadow-[inset_0_0_0_1px_var(--color-border)] transition-colors hover:text-primary">
        {name}
        <span class="rounded-full bg-accent px-2 py-0.5 font-mono text-xs text-accent-foreground">{len(list)}</span>
      </a>
    ))
    items := []*ui.Node{}
    for _, x := range list {
      file := x.get_str("file", "")
      info := i18n.tv("examples.items").field(file)
      items = append(items, (
        <article class="flex min-w-0 flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <h3 class="text-[22px] font-bold">{info.get_str("title", "")}</h3>
            <p class="text-[15px] leading-relaxed text-muted-foreground">{info.get_str("description", "")}</p>
          </div>
          <core.CodeWindow file={file} code={x.get_str("code", "")} output={home.strs(x.get("output"))} flat={true} />
        </article>
      ))
    }
    let cls: any = nil
    if gi % 2 == 1 { cls = "bg-surface" }
    sections = append(sections, (
      <section id={id} aria-labelledby={id + "-h"} class={cls}>
        <core.Container cls="flex flex-col gap-10 py-16 sm:py-20">
          <div class="flex items-center gap-3">
            <div aria-hidden="true" class="size-2.5 rounded-full bg-primary"></div>
            <h2 id={id + "-h"} class="text-[28px] font-bold tracking-[-0.03em] sm:text-[34px]">{name}</h2>
          </div>
          <div class="grid grid-cols-1 gap-x-8 gap-y-12 lg:grid-cols-2">{items}</div>
        </core.Container>
      </section>
    ))
  }
  return (
    <>
      <core.PageHero crumb={i18n.tr("examples.title")} title={i18n.tr("examples.title")} lead={ui.frag(i18n.rt("examples.lead"))}>
        <nav aria-label={i18n.tr("examples.groupsLabel")} class="flex flex-wrap gap-2.5">{chips}</nav>
      </core.PageHero>
      {sections}
      <section class="relative overflow-hidden bg-inverse text-inverse-foreground">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 text-[#C8232F] opacity-10 [mask-image:linear-gradient(90deg,transparent_40%,black_100%)]">
          {core.cashew_pattern("examples-cta", "", "")}
        </div>
        <core.Container cls="flex flex-wrap items-center justify-between gap-6 py-16">
          <h2 class="text-[34px] font-bold tracking-[-0.03em] sm:text-[44px]">{i18n.tr("examples.ctaTitle")}</h2>
          <a class={core.BIG_PRIMARY} href={i18n.lp("/") + "#install"}>{i18n.tr("examples.ctaButton")}</a>
        </core.Container>
      </section>
    </>
  )
}
